# Copy this file to .env and fill in real values. Never commit the real .env file.

DISCORD_TOKEN=your_discord_bot_token_here

# Optional but recommended during development: your Discord server's ID.
# Right-click your server icon in Discord (with Developer Mode enabled in
# Discord settings) -> Copy Server ID. Makes slash commands sync instantly
# instead of waiting up to an hour for a global sync.
GUILD_ID=your_server_id_here

# Added in a later step, not needed yet for /ping:
RIOT_API_KEY=your_riot_api_key_here

# The channel where loss/accountability-task messages get posted.
# Right-click the channel (Developer Mode enabled) -> Copy Channel ID.
# Without this set, the match-polling loop won't start.
ANNOUNCE_CHANNEL_ID=your_channel_id_here

# --- API (api/main.py) ---
# Discord OAuth2 app credentials for the web dashboard login flow. Get these
# from https://discord.com/developers/applications -> your app -> OAuth2 tab
# (you can reuse the bot's application; these are separate credentials from
# DISCORD_TOKEN).
DISCORD_CLIENT_ID=your_oauth_client_id_here
DISCORD_CLIENT_SECRET=your_oauth_client_secret_here
# The browser hits this through the frontend's proxy (Vite dev server
# locally, nginx in production), not this API's own port directly -- see
# api/auth.py's docstring. Register the SAME url under "Redirects" on
# Discord's OAuth2 page, exact match required.
# Local dev:  http://localhost:5173/api/auth/callback
# Production: http://<your-domain-or-ip>/api/auth/callback
DISCORD_REDIRECT_URI=http://localhost:5173/api/auth/callback

# Where to send the browser after a successful login.
# Local dev:  http://localhost:5173
# Production: http://<your-domain-or-ip>
FRONTEND_URL=http://localhost:5173

# Secret used to sign our own session JWTs. Any long random string, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Keep this secret -- anyone with it can forge a session token for any
# discord_id.
JWT_SECRET=your_random_jwt_secret_here

# Set to true once the site is served over https (needed for the session
# cookie's Secure flag). Leave false for local dev and for an http-only VM.
COOKIE_SECURE=false

# Port the API listens on (optional, defaults to 8001).
API_PORT=8001
